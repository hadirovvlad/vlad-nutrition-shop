# --- Database ---------------------------------------------------------------
# SQLite (default, zero setup). For PostgreSQL switch the provider in
# prisma/schema.prisma to "postgresql" and use a URL such as:
# DATABASE_URL="postgresql://user:password@localhost:5432/sportshop?schema=public"
DATABASE_URL="file:./dev.db"

# --- Server -----------------------------------------------------------------
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# --- Auth -------------------------------------------------------------------
# Generate a real secret for production: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Seed accounts ----------------------------------------------------------
SEED_ADMIN_EMAIL=admin@vladnutrition.ua
SEED_ADMIN_PASSWORD=Admin1234
SEED_MANAGER_EMAIL=manager@vladnutrition.ua
SEED_MANAGER_PASSWORD=Manager1234
SEED_CLIENT_EMAIL=client@vladnutrition.ua
SEED_CLIENT_PASSWORD=Client1234
