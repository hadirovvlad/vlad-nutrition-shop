# --- Database ---------------------------------------------------------------
# "sqlite" (default, zero setup) or "postgresql". The value rewrites the
# provider in prisma/schema.prisma before any prisma command runs, because
# Prisma does not accept env() there. See server/scripts/db-provider.mjs.
DATABASE_PROVIDER=sqlite

DATABASE_URL="file:./dev.db"
# PostgreSQL example:
# DATABASE_PROVIDER=postgresql
# DATABASE_URL="postgresql://user:password@localhost:5432/vlad_nutrition?schema=public"

# --- Server -----------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Origins allowed to send credentialed cross-origin requests, comma-separated.
# Leave empty in production: the server serves the built SPA from its own
# origin, so no cross-origin access is needed.
CLIENT_ORIGIN=http://localhost:5173

# --- Auth -------------------------------------------------------------------
# Generate a real secret for production: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Seed accounts ----------------------------------------------------------
SEED_ADMIN_EMAIL=admin@vladnutrition.ua
SEED_ADMIN_PASSWORD=Admin1234
SEED_MANAGER_EMAIL=manager@vladnutrition.ua
SEED_MANAGER_PASSWORD=Manager1234
SEED_CLIENT_EMAIL=client@vladnutrition.ua
SEED_CLIENT_PASSWORD=Client1234
